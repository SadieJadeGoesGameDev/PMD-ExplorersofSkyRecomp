+            rends[e]->WideSkip = 0;
+            for (int k = 0; k < 4; k++) if (u.BGXPos[k] == 0 && u.BGYPos[k] == 0) rends[e]->WideSkip |= 1 << k;
+            for (int k = 0; k < 4; k++) { savedX[e][k] = u.BGXPos[k]; u.BGXPos[k] = (u16)(u.BGXPos[k] + delta); }
+            u16* oam = (u16*)&GPU.OAM[e ? 0x400 : 0];
+            for (int s = 0; s < 128; s++)
+            {
+                u16& a1 = oam[s * 4 + 1];
+                savedOAMX[e][s] = a1;
+                a1 = (a1 & ~0x1FF) | ((a1 - delta) & 0x1FF);
+            }
+            rends[e]->WideEdge = rends[e]->EdgeMask[side];
+        }
+        // 3D layer: the 3D renderer draws the scene wide (GPU3D.WideMargin3D), so the margins get real 3D pixels
+        {
+            auto* r3d = dynamic_cast<SoftRenderer3D*>(Rend3D.get());
+            memset(WideLine3D, 0, sizeof(WideLine3D));
+            if (r3d && GPU.GPU3D.WideMargin3D == W) memcpy(WideLine3D, r3d->WideLines[side][line], W * 4);
+            // full-screen translucent tints drawn as an exactly-4:3 quad (fades, night): carry them on where the
+            // wide render has nothing
+            u32 edge = real3D ? real3D[side == 0 ? 0 : 255] : 0, ea = (edge >> 24) & 0x1F;
+            bool uniform = real3D && real3D[0] == real3D[64] && real3D[0] == real3D[128] && real3D[0] == real3D[192] && real3D[0] == real3D[255];
+            if (uniform && ea > 0)
+                for (int i = 0; i < W; i++) if (!((WideLine3D[i] >> 24) & 0x1F)) WideLine3D[i] = edge;
+        }
+        Output3D = WideLine3D;
+        rends[0]->DrawSprites(line);
+        rends[1]->DrawSprites(line);
+        rends[0]->DrawScanline(line);
+        rends[1]->DrawScanline(line);
+        alignas(8) u32 tA[256], tB[256];
+        DrawScanlineA(line, tA);
+        DrawScanlineB(line, tB);
+        ExpandColor(tA);
+        ExpandColor(tB);
+        int scrA = GPU.ScreenSwap ? 0 : 1;
+        memcpy(&WideSide[BackBuffer][scrA][side][line * W], tA, W * 4);
+        memcpy(&WideSide[BackBuffer][scrA ^ 1][side][line * W], tB, W * 4);
+        for (int e = 0; e < 2; e++)
+        {
+            melonDS::GPU2D& u = *units[e];
+            for (int k = 0; k < 4; k++) u.BGXPos[k] = savedX[e][k];
+            u16* oam = (u16*)&GPU.OAM[e ? 0x400 : 0];
+            for (int s = 0; s < 128; s++) oam[s * 4 + 1] = savedOAMX[e][s];
+            rends[e]->WideEdge = -1;
+        }
+    }
+    Output3D = real3D;
+}
+
+void SoftRenderer::GetWideMargins(int screen, u32** left, u32** right)
+{
+    int frontbuf = BackBuffer ^ 1;
+    *left = WideSide[frontbuf][screen][0];
+    *right = WideSide[frontbuf][screen][1];
+}
